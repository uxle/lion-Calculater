// ═══════════════════════════════════════════════════════════════════════════
//  Lion Calculator  ·  basic_pad.slint
//  LionOS Design System  ·  Rust + Slint 1.17
// ═══════════════════════════════════════════════════════════════════════════

import { LT } from "tokens.slint";
import { CalcButton } from "calc_button.slint";

// ── BasicPad ───────────────────────────────────────────────────────────────
export component BasicPad {

    callback button-pressed(string);

    VerticalLayout {
        spacing: LT.gap;

        // Memory row: MC · MR · M+ · M− · MS
        // (the logic existed in the backend but no pad ever exposed it)
        HorizontalLayout {
            width: 282px;
            padding-left: LT.pad;
            padding-right: LT.pad;
            spacing: LT.gap;

            CalcButton {
                lbl: "MC"; btn-width: 42px; fs: 14px; fg: LT.t-dim;
                clicked => { root.button-pressed("MC"); }
            }
            CalcButton {
                lbl: "MR"; btn-width: 42px; fs: 14px; fg: LT.t-dim;
                clicked => { root.button-pressed("MR"); }
            }
            CalcButton {
                lbl: "M+"; btn-width: 42px; fs: 14px; fg: LT.t-dim;
                clicked => { root.button-pressed("M+"); }
            }
            CalcButton {
                lbl: "M−"; btn-width: 42px; fs: 14px; fg: LT.t-dim;
                clicked => { root.button-pressed("M−"); }
            }
            CalcButton {
                lbl: "MS"; btn-width: 42px; fs: 14px; fg: LT.t-dim;
                clicked => { root.button-pressed("MS"); }
            }
        }

        GridLayout {
            spacing: LT.gap;
            padding: LT.pad;

        // Row 0
        Row {
            CalcButton {
                lbl: "AC";
                is-square: true;
                fg: LT.t-dn;
                clicked => { root.button-pressed("AC"); }
            }

            CalcButton {
                has-icon: true;
                icon: @image-url("svg/delete-left.svg");
                is-square: true;
                fg: LT.t-dn;
                clicked => { root.button-pressed("⌫"); }
            }

            CalcButton {
                has-icon: true;
                icon: @image-url("svg/percent.svg");
                is-square: true;
                fg: LT.t-op;
                clicked => { root.button-pressed("%"); }
            }

            CalcButton {
                has-icon: true;
                icon: @image-url("svg/divide.svg");
                is-square: true;
                fg: LT.t-op;
                clicked => { root.button-pressed("÷"); }
            }
        }

        // Row 1
        Row {
            CalcButton {
                lbl: "7";
                is-square: true;
                clicked => { root.button-pressed("7"); }
            }

            CalcButton {
                lbl: "8";
                is-square: true;
                clicked => { root.button-pressed("8"); }
            }

            CalcButton {
                lbl: "9";
                is-square: true;
                clicked => { root.button-pressed("9"); }
            }

            CalcButton {
                has-icon: true;
                icon: @image-url("svg/xmark.svg");
                is-square: true;
                fg: LT.t-op;
                clicked => { root.button-pressed("×"); }
            }
        }

        // Row 2
        Row {
            CalcButton {
                lbl: "4";
                is-square: true;
                clicked => { root.button-pressed("4"); }
            }

            CalcButton {
                lbl: "5";
                is-square: true;
                clicked => { root.button-pressed("5"); }
            }

            CalcButton {
                lbl: "6";
                is-square: true;
                clicked => { root.button-pressed("6"); }
            }

            CalcButton {
                has-icon: true;
                icon: @image-url("svg/minus.svg");
                is-square: true;
                fg: LT.t-op;
                clicked => { root.button-pressed("−"); }
            }
        }

        // Row 3
        Row {
            CalcButton {
                lbl: "1";
                is-square: true;
                clicked => { root.button-pressed("1"); }
            }

            CalcButton {
                lbl: "2";
                is-square: true;
                clicked => { root.button-pressed("2"); }
            }

            CalcButton {
                lbl: "3";
                is-square: true;
                clicked => { root.button-pressed("3"); }
            }

            CalcButton {
                has-icon: true;
                icon: @image-url("svg/plus.svg");
                is-square: true;
                fg: LT.t-op;
                clicked => { root.button-pressed("+"); }
            }
        }

        // Row 4
        Row {
            CalcButton {
                colspan: 2; cols: 2;
                lbl: "0";
                clicked => { root.button-pressed("0"); }
            }

            CalcButton {
                lbl: ".";
                is-square: true;
                clicked => { root.button-pressed("."); }
            }

            CalcButton {
                has-icon: true;
                icon: @image-url("svg/equals.svg");
                is-square: true;
                fg: #ffffff;
                bg: LT.eq;
                hov: LT.eq-hov;
                prs: LT.eq-prs;
                clicked => { root.button-pressed("="); }
            }
        }
        }
    }
}
